{
  "name": "dsh-model-reasoning-defaults",
  "version": "0.0.2",
  "description": "DSH (DeepSeek Harness) 插件：为每个 LLM 模型配置默认推理等级（reasoningEffort），并在请求进入底层调用链前按路由规则自动补齐",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "llm",
    "dsh-plugin",
    "reasoning",
    "reasoning-effort",
    "cordis"
  ],
  "type": "module",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "author": {
    "name": "xht-code",
    "url": "https://github.com/xht-code"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xht-code/dsh-model-reasoning-defaults.git"
  },
  "homepage": "https://github.com/xht-code/dsh-model-reasoning-defaults",
  "bugs": {
    "url": "https://github.com/xht-code/dsh-model-reasoning-defaults/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cosmokit": "^1.8.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown && tsc -p tsconfig.client.json",
    "typecheck": "pnpm run typecheck:host && pnpm run typecheck:client && pnpm run typecheck:test",
    "typecheck:host": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  }
}
