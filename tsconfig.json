{
  // Host 侧编译与 typecheck 配置；产物由 tsdown 生成，本文件只负责声明与检查。
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // 不设 rootDir：include 同时覆盖 src/ 与根目录 tsdown.config.ts，固定根会触发 TS6059。
    "declaration": true,
    "declarationDir": "lib/types",
    "outDir": "lib",
    "sourceMap": true
  },
  "include": [
    "src/index.ts",
    "tsdown.config.ts"
  ],
  "exclude": [
    "src/client",
    "lib"
  ]
}
